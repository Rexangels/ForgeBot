FORGEBOT_SECRET_KEY=change-me-in-production
FORGEBOT_DEBUG=1
FORGEBOT_HOSTS=localhost,127.0.0.1
# PostgreSQL (leave empty for local SQLite demo):
FORGEBOT_DATABASE_URL=
FORGEBOT_MEDIA_ROOT=./media
FORGEBOT_MEDIA_BACKEND=local
FORGEBOT_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FORGEBOT_MAX_UPLOAD_MB=10
FORGEBOT_JOB_TIMEOUT_S=600
FORGEBOT_ARTIFACT_RETENTION_DAYS=14
# Optional override; FreeCAD is auto-detected on this machine when blank:
FORGEBOT_FREECAD_EXECUTABLE=
# Meta Model API (server-side only; never commit real keys):
FORGEBOT_MODEL_PROVIDER=meta-model-api
FORGEBOT_MODEL_NAME=muse-spark-1.3
FORGEBOT_MODEL_API_BASE_URL=https://api.meta.ai/v1
FORGEBOT_MODEL_API_KEY=
